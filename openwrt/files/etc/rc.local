# 定义目标挂载点
/etc/init.d/dnsmasq start
MOUNT_POINT="/mnt/dkroot"
NFS_SERVER="192.168.50.23:/rpool/dkroot-wrt"
#NFS_SERVER="192.168.50.10:/satar5/routrdockr"

/etc/init.d/network enabled
/etc/init.d/network start
mount -o rw,remount /dev/sda2 /

source /etc/profile.d/btop.sh

/usr/bin/vlmcsd -D -i "/etc/vlmcsd.ini" -l syslog -L "192.168.50.1:1688"

if ps -ef | grep -q dockerd; then
  # 如果 dockerd 正在运行，则停止它
  echo "正在停止 dockerd 服务..."
  /etc/init.d/dockerd stop &&  umount /tmp/lib/docker  && umount /dev/root
  echo "dockerd 服务已停止。"
else
  # 如果 dockerd 未运行，则输出提示信息
  umount /tmp/lib/docker 
  echo "dockerd 服务未运行。"
fi

/etc/init.d/rpcd start

sleep 2
mount.nfs4 -o rsize=65536,wsize=65536,rw,nodiratime,noatime,nolock 192.168.50.23:/rpool/opt-wrt /opt
sleep 2
# 检查 /mnt/dkroot 是否存在
if [ -d "$MOUNT_POINT" ]; then
    # 如果存在，直接挂载 NFS 并启动 dockerd
    echo "挂载点 $MOUNT_POINT 已存在，正在挂载 NFS 并启动 dockerd..."
    mount.nfs4 -o rsize=65536,wsize=65536,rw,nodiratime,noatime,nolock "$NFS_SERVER" "$MOUNT_POINT" && \
    /usr/bin/dockerd --config-file /opt/dockercfg/daemon.json &
else
    # 如果不存在，创建目录后再挂载 NFS 并启动 dockerd
    echo "挂载点 $MOUNT_POINT 不存在，正在创建并挂载 NFS..."
    mkdir -p "$MOUNT_POINT" && \
    mount.nfs4 -o rsize=65536,wsize=65536,rw,nodiratime,noatime,nolock "$NFS_SERVER" "$MOUNT_POINT" && \
    /usr/bin/dockerd --config-file /opt/dockercfg/daemon.json &
fi

# 检查命令执行结果
if [ $? -eq 0 ]; then
    echo "NFS 挂载和 dockerd 启动成功。"
else
    echo "操作失败，请检查 NFS 服务器或权限设置。"
fi

/etc/init.d/dropbear start
echo -E "#/bin/bash" >  /opt/getwanip.sh && chmod +x /opt/getwanip.sh
echo -E "ifconfig pppoe-wan|grep -e 'inet ' |awk '{print $2}'|grep -oE '[0-9.]*'" >>  /opt/getwanip.sh 

homebox && /etc/init.d/dropbear enable


cp /usr/share/passwall/rules/chnlist /etc/smartdns/domain-set/
cp /usr/share/passwall/rules/direct_host /etc/smartdns/domain-set/
/etc/init.d/smartdns start
/etc/init.d/passwall enable && /etc/init.d/passwall start
exit 0