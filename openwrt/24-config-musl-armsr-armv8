### Init
CONFIG_TARGET_armsr=n
CONFIG_TARGET_armsr_armv8=n
CONFIG_TARGET_armsr_armv8_DEVICE_generic=n

### Basic
CONFIG_ALL_KMODS=n
CONFIG_ALL_NONSHARED=n
CONFIG_KERNEL_BUILD_DOMAIN="lemetweaku.com"
CONFIG_KERNEL_BUILD_USER="afro"
CONFIG_KERNEL_MEMCG_V1=n
CONFIG_KERNEL_MPTCP=n
CONFIG_KERNEL_MPTCP_IPV6=n
# CONFIG_KERNEL_PREEMPT_RT is not set
CONFIG_PACKAGE_autocore-arm=n
CONFIG_PACKAGE_bind-host=n
CONFIG_PACKAGE_block-mount=n
CONFIG_PACKAGE_coremark=n
CONFIG_PACKAGE_default-settings=n
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=4864
CONFIG_COREMARK_NUMBER_OF_THREADS=2
# CONFIG_KERNEL_KALLSYMS is not set

# CONFIG_TARGET_PREINIT_
CONFIG_TARGET_PREINIT_IP="192.168.50.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.254.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.51.255"

CONFIG_TARGET_INIT_PATH="/usr/sbin:/usr/bin:/sbin:/bin"
CONFIG_TARGET_INIT_ENV="/etc/rc.local"
CONFIG_TARGET_INIT_CMD="/sbin/init"

CONFIG_PER_FEED_REPO=y
CONFIG_FEED_packages=y
CONFIG_FEED_luci=y
CONFIG_FEED_routing=y
CONFIG_FEED_telephony=y
